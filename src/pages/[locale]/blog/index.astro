---
import { getEmDashCollection } from "emdash";
import ArchivePage from "../../../components/ArchivePage.astro";
import { t, locales, type Locale, defaultLocale } from "../../../i18n/utils";

// Validate locale
const { locale: localeParam } = Astro.params;
const locale: Locale = locales.includes(localeParam as Locale)
	? (localeParam as Locale)
	: defaultLocale;

if (!locales.includes(localeParam as Locale)) {
	return Astro.redirect(`/${defaultLocale}/blog`, 302);
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
});

Astro.cache.set(cacheHint);
---

<ArchivePage
	posts={posts}
	collection="posts"
	section="blog"
	locale={locale}
	title={t("nav.blog", locale)}
	description={locale === "ar" ? "مقالات عن البرمجة والذكاء الاصطناعي" : "Writing on development, AI, and building"}
	rssHref="/rss/posts.xml"
/>
