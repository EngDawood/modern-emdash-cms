---
import ArticlePage from "../../../components/ArticlePage.astro";
import { resolveLocalizedEntry } from "../../../utils/i18n-content";
import { locales, type Locale, defaultLocale } from "../../../i18n/utils";

// Validate locale
const { locale: localeParam, slug } = Astro.params;
const locale: Locale = locales.includes(localeParam as Locale)
	? (localeParam as Locale)
	: defaultLocale;

if (!slug) {
	return Astro.rewrite("/404");
}

const {
	entry: post,
	cacheHint,
	foundIn,
} = await resolveLocalizedEntry("posts", slug, locale);

if (!post) {
	// Untranslated post: point at the locale that has it rather than 404ing a
	// URL Google may already have indexed. Carry the query string over so a
	// draft preview arriving under the wrong locale keeps its `_preview` token.
	if (foundIn) {
		return Astro.redirect(`/${foundIn}/blog/${slug}${Astro.url.search}`, 301);
	}
	return Astro.rewrite("/404");
}

Astro.cache.set(cacheHint);
---

<ArticlePage
	entry={post}
	collection="posts"
	section="blog"
	locale={locale}
	slug={slug}
	comments
/>
