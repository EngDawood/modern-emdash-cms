---
import { t, type Locale } from "../../i18n/utils";
import BrandIcon from "../BrandIcon.astro";

interface Props {
	locale: Locale;
	email: string;
}

const { locale, email } = Astro.props;

const marqueeItems: { label: string; brand?: string }[] = [
	{ label: "TypeScript", brand: "typescript" },
	{ label: "Cloudflare Workers", brand: "cloudflare workers" },
	{ label: "Hono", brand: "hono" },
	{ label: "Open to Work" },
];
// Each loop half repeats the set so it is wider than any viewport.
const SETS_PER_HALF = 5;
---

<section id="hero" class="hero">
	<div class="hero-inner">
		<div class="masthead-bar">
			<span class="masthead-vol">Vol. V · {new Date().getFullYear()}</span>
			<span class="masthead-sep">◆</span>
			<span class="masthead-loc">{t("hero.location", locale)}</span>
			<span class="masthead-sep">◆</span>
			<span class="masthead-avail">
				<span class="avail-dot"></span>
				{t("hero.available", locale)}
			</span>
		</div>

		<div class="bilingual-lockup" dir="ltr">
			<div class="lockup-latin">
				<span class="lockup-lang">Lat. · 01</span>
				<span class="lockup-first">Dawood</span>
				<em class="lockup-last">Saleh.</em>
			</div>
			<div class="lockup-pivot">
				<span class="pivot-line"></span>
				<span class="pivot-diamond">◆</span>
				<span class="pivot-line"></span>
			</div>
			<div class="lockup-arabic" dir="rtl">
				<span class="lockup-lang" dir="ltr">Ar. · 02</span>
				<span class="lockup-first-ar">داوود</span>
				<span class="lockup-last-ar">صالح.</span>
			</div>
		</div>

		<hr class="masthead-rule" />

		<div class="hero-body">
			<div class="hero-lede">
				<p class="hero-role">{t("hero.role", locale)} —</p>
				<p class="hero-lede-text">{t("hero.subtitle", locale)}</p>
				<div class="hero-cta-row">
					<a href={`mailto:${email}`} class="btn btn-primary">{t("hero.cta", locale)}</a>
					<a href="#work" class="btn btn-ghost">{t("hero.viewProjects", locale)}</a>
				</div>
			</div>
			<aside class="hero-side">
				<div class="stack-label">— {locale === "ar" ? "الأدوات" : "Stack"} —</div>
				<div class="hero-stack-list">
					{t("hero.stack", locale).split(" · ").map((s: string) => (
						<div class="stack-item">
							<BrandIcon name={s} class="stack-logo" />
							<span>{s}</span>
						</div>
					))}
				</div>
				<div class="hero-metrics">
					<div class="metric"><b>4M+</b><span>{t("hero.metrics.records", locale)}</span></div>
					<div class="metric"><b>9+</b><span>{t("hero.metrics.platforms", locale)}</span></div>
					<div class="metric"><b>5+</b><span>{t("hero.metrics.years", locale)}</span></div>
				</div>
			</aside>
		</div>
	</div>
	<div class="hero-ticker">
	<div class="marquee" data-marquee data-rtl={locale === "ar" ? "" : undefined}>
		<div class="marquee-viewport" dir="ltr" role="group" aria-label={t("hero.marquee.label", locale)}>
			<div class="marquee-track">
				{[0, 1].map((half) => (
					<div class:list={["marquee-half", { "is-dup": half > 0 }]}>
						{Array.from({ length: SETS_PER_HALF }, (_, set) => {
							const dup = half > 0 || set > 0;
							return (
								<ul
									class:list={["marquee-set", { "is-dup": dup }]}
									role="list"
									aria-hidden={dup ? "true" : undefined}
									inert={dup}
								>
									{marqueeItems.map((item) => (
										<li class="marquee-item">
											{item.brand && <BrandIcon name={item.brand} class="marquee-logo" />}
											<span>{item.label}</span>
											<span class="marquee-sep" aria-hidden="true">·</span>
										</li>
									))}
								</ul>
							);
						})}
					</div>
				))}
			</div>
		</div>
		<button
			type="button"
			class="marquee-toggle"
			data-marquee-toggle
			data-pause={t("hero.marquee.pause", locale)}
			data-resume={t("hero.marquee.resume", locale)}
			hidden
		>
			<svg class="marquee-toggle-icon" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
				<g data-icon-pause fill="currentColor"><rect x="1.5" y="1" width="2.5" height="8" /><rect x="6" y="1" width="2.5" height="8" /></g>
				<path data-icon-play fill="currentColor" d="M2 1 9 5 2 9Z" />
			</svg>
			<span data-marquee-label>{t("hero.marquee.pause", locale)}</span>
		</button>
	</div>
	</div>
</section>

<script>
	// Progressive enhancement: without JS, with reduced motion, or without CSS
	// animation support the logos stay a static wrapping grid.
	const root = document.querySelector<HTMLElement>("[data-marquee]");
	const button = root?.querySelector<HTMLButtonElement>("[data-marquee-toggle]");
	const label = root?.querySelector<HTMLElement>("[data-marquee-label]");

	if (root && button && label) {
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
		const canAnimate = !!window.CSS?.supports?.("animation-name", "none");
		let paused = false;

		const render = () => {
			root.toggleAttribute("data-paused", paused);
			label.textContent = (paused ? button.dataset.resume : button.dataset.pause) ?? "";
		};
		const sync = () => {
			const active = canAnimate && !reduced.matches;
			root.toggleAttribute("data-active", active);
			button.hidden = !active;
		};

		button.addEventListener("click", () => {
			paused = !paused;
			render();
		});
		reduced.addEventListener("change", sync);
		sync();
		render();
	}
</script>

<style>
	/* ── Hero ── */
	.hero {
		border-bottom: 1px solid var(--color-border);
	}

	.hero-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-12);
	}

	.masthead-bar {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: var(--spacing-10);
	}

	.masthead-sep {
		color: var(--color-accent);
		font-size: 8px;
	}

	.masthead-avail {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.avail-dot {
		width: 6px;
		height: 6px;
		background: #22c55e;
		border-radius: 50%;
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	/* Bilingual Lockup */
	.bilingual-lockup {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(32px, 5vw, 72px);
		margin-bottom: var(--spacing-8);
	}

	.lockup-latin,
	.lockup-arabic {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.lockup-latin {
		align-items: flex-end;
	}

	.lockup-arabic {
		align-items: flex-start;
	}

	.lockup-lang {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.lockup-first {
		font-family: "Playfair Display", Georgia, serif;
		font-size: clamp(36px, 6vw, 72px);
		font-weight: 500;
		color: var(--color-text);
		line-height: 0.95;
		letter-spacing: -0.03em;
	}

	.lockup-last {
		font-family: "Playfair Display", Georgia, serif;
		font-size: clamp(36px, 6vw, 72px);
		font-weight: 400;
		font-style: italic;
		color: var(--color-accent);
		line-height: 0.95;
		letter-spacing: -0.02em;
	}

	.lockup-first-ar {
		font-family: "Amiri", "Al Jazeera", serif;
		font-size: clamp(40px, 6.5vw, 80px);
		font-weight: 700;
		color: var(--color-text);
		line-height: 0.95;
	}

	.lockup-last-ar {
		font-family: "Amiri", "Al Jazeera", serif;
		font-size: clamp(40px, 6.5vw, 80px);
		font-weight: 400;
		color: var(--color-accent);
		line-height: 0.95;
	}

	.lockup-pivot {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		flex-shrink: 0;
	}

	.pivot-line {
		display: block;
		width: 1px;
		height: clamp(40px, 5vw, 64px);
		background: var(--color-text);
		opacity: 0.18;
	}

	.pivot-diamond {
		color: var(--color-accent);
		font-size: 18px;
		line-height: 1;
	}

	.masthead-rule {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: var(--spacing-8) 0;
	}

	/* Hero body */
	.hero-body {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--spacing-12);
		align-items: start;
	}

	.hero-role {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: var(--spacing-3);
	}

	.hero-lede-text {
		font-family: var(--font-serif);
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
		line-height: 1.6;
		max-width: 480px;
		margin-bottom: var(--spacing-8);
	}

	.hero-cta-row {
		display: flex;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	.hero-side {
		min-width: 180px;
		border-left: 1px solid var(--color-border);
		padding-left: var(--spacing-8);
	}

	html[dir="rtl"] .hero-side {
		border-left: none;
		border-right: 1px solid var(--color-border);
		padding-left: 0;
		padding-right: var(--spacing-8);
	}

	.stack-label {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.2em;
		color: var(--color-muted);
		text-transform: uppercase;
		margin-bottom: var(--spacing-4);
		text-align: center;
	}

	.hero-stack-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-6);
	}

	.stack-item {
		--brand-icon-size: 14px;
		--brand-icon-color: var(--color-accent);
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-serif);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.hero-metrics {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-4);
	}

	.metric {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.metric b {
		font-family: var(--font-serif);
		font-size: var(--font-size-xl);
		font-weight: 500;
		color: var(--color-text);
		line-height: 1;
		/* Keep "4M+" intact — the neutral + flips ahead of the digits in RTL */
		direction: ltr;
		unicode-bidi: isolate;
	}

	/* direction: ltr above also resets text-align, so restore the RTL edge */
	html[dir="rtl"] .metric b {
		text-align: right;
	}

	.metric span {
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	/* Logo marquee. Default = static wrapping grid; [data-active] (set by JS) animates. */
	.hero-ticker {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-6) var(--spacing-8);
	}

	.marquee {
		--marquee-duration: 100s;
		background: var(--color-accent);
		color: var(--color-on-accent);
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 14px var(--spacing-6);
	}

	.marquee-viewport {
		flex: 1;
		min-width: 0;
		overflow: hidden;
	}

	.marquee-track {
		display: flex;
		width: max-content;
		max-width: 100%;
	}

	.marquee-half {
		display: flex;
		flex: none;
	}

	.marquee-set {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 10px var(--spacing-8);
	}

	/* Loop duplicates exist only while animating. */
	.is-dup { display: none; }

	.marquee-item {
		--brand-icon-size: 18px;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 18px;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.marquee-sep { display: none; }

	/* Static grid fills the strip. */
	.marquee:not([data-active]) .marquee-track,
	.marquee:not([data-active]) .marquee-half,
	.marquee:not([data-active]) .marquee-set { width: 100%; }

	/* Animated */
	.marquee[data-active] .marquee-viewport {
		-webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
	}

	.marquee[data-active] .marquee-track {
		width: max-content;
		max-width: none;
		animation: marquee var(--marquee-duration) linear infinite;
	}

	.marquee[data-active] .is-dup { display: flex; }

	.marquee[data-active] .marquee-set {
		flex-wrap: nowrap;
		justify-content: flex-start;
		gap: 0;
		flex: none;
	}

	.marquee[data-active] .marquee-item { padding-inline-end: var(--spacing-8); gap: 10px; }
	.marquee[data-active] .marquee-sep { display: inline; opacity: 0.5; margin-inline-start: var(--spacing-8); }

	.marquee[data-active][data-rtl] .marquee-track { animation-direction: reverse; }
	.marquee[data-paused] .marquee-track { animation-play-state: paused; }

	@keyframes marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	.marquee-toggle {
		flex: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: inherit;
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--color-on-accent) 55%, transparent);
		border-radius: 999px;
		cursor: pointer;
	}

	.marquee-toggle[hidden] { display: none; }
	.marquee-toggle:hover { background: color-mix(in srgb, var(--color-on-accent) 14%, transparent); }
	.marquee-toggle:focus-visible { outline: 2px solid var(--color-on-accent); outline-offset: 3px; }
	.marquee-toggle-icon { width: 10px; height: 10px; }

	/* Small screens: icon-only button so the logos keep the width. The label stays as its accessible name. */
	@media (max-width: 640px) {
		.marquee { gap: var(--spacing-3); padding-inline: var(--spacing-4); }
		.marquee-toggle {
			position: relative;
			width: 34px;
			height: 34px;
			padding: 0;
			justify-content: center;
		}
		.marquee-toggle [data-marquee-label] {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}
	.marquee-toggle [data-icon-play],
	.marquee[data-paused] .marquee-toggle [data-icon-pause] { display: none; }
	.marquee[data-paused] .marquee-toggle [data-icon-play] { display: inline; }

	/* ── Responsive ── */
	@media (max-width: 768px) {
		.bilingual-lockup {
			gap: 20px;
		}

		.lockup-first,
		.lockup-last {
			font-size: clamp(28px, 7vw, 48px);
		}

		.lockup-first-ar,
		.lockup-last-ar {
			font-size: clamp(32px, 7.5vw, 52px);
		}

		.hero-body {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}

		.hero-side {
			border-left: none;
			border-top: 1px solid var(--color-border);
			padding-left: 0;
			padding-top: var(--spacing-6);
			display: flex;
			gap: var(--spacing-8);
			align-items: flex-start;
		}

		html[dir="rtl"] .hero-side {
			border-right: none;
			padding-right: 0;
		}

		.hero-metrics {
			flex-direction: row;
			flex-wrap: wrap;
			gap: var(--spacing-5);
			border-top: none;
			padding-top: 0;
		}
	}

	@media (max-width: 480px) {
		.bilingual-lockup {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: var(--spacing-4);
		}

		.lockup-latin { align-items: center; }
		.lockup-arabic { align-items: center; }

		.lockup-pivot {
			flex-direction: row;
			height: auto;
			width: 100%;
			justify-content: center;
		}

		.pivot-line {
			width: clamp(32px, 10vw, 60px);
			height: 1px;
		}

		.masthead-bar {
			flex-wrap: wrap;
			gap: 8px;
		}
	}
</style>
