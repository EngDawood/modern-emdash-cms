---
import { t, type Locale } from "../../i18n/utils";

interface Props {
	/** Each lesson carries the locale it lives in — an untranslated lesson is
	 * listed here but links to the locale that actually has it. */
	featuredLessons: Array<{ entry: any; locale: Locale }>;
	locale: Locale;
}

const { featuredLessons, locale } = Astro.props;
---

<section id="mcp" class="section-mcp reveal">
	<div class="section-inner">
		<div class="section-head reveal-child">
			<div class="kicker">
				<span class="kicker-num">§04</span>
				<span class="kicker-rule"></span>
				{t("mcpCourse.kicker", locale)}
			</div>
			<h2 class="section-title">{t("mcpCourse.heading", locale)}</h2>
			<p class="section-sub">{t("mcpCourse.subheading", locale)}</p>
		</div>
		<div class="lesson-rows">
			{featuredLessons.map(({ entry: lesson, locale: entryLocale }, i) => (
				<a href={`/${entryLocale}/mcp/${lesson.id}`} class="lesson-row reveal-item" style={`--delay: ${i}`}>
					<div class="row-meta">
						<span class="row-num">{String(lesson.data.lesson_number ?? i + 1).padStart(2, "0")}</span>
						<span class="row-year">
							{lesson.data.level}
							{lesson.data.reading_minutes ? ` · ${lesson.data.reading_minutes} ${t("writing.min", locale)}` : ""}
						</span>
						{entryLocale !== locale && (
							<span class="row-lang" lang={entryLocale}>
								{t(entryLocale === "ar" ? "project.onlyInArabic" : "project.onlyInEnglish", locale)}
							</span>
						)}
					</div>
					<h3 class="row-title" dir="auto">{lesson.data.title}</h3>
					<p class="row-desc" dir="auto">{lesson.data.excerpt}</p>
					<div class="row-footer">
						<span class="row-arrow">{locale === "ar" ? "←" : "→"}</span>
					</div>
				</a>
			))}
		</div>
		<a href={`/${locale}/mcp`} class="view-all reveal-child">{t("mcpCourse.viewAll", locale)} {locale === "ar" ? "←" : "→"}</a>
	</div>
</section>

<style>
	/* ── MCP course §04 ── */
	.section-mcp {
		background: var(--color-bg-subtle);
		border-bottom: 1px solid var(--color-border);
	}

	.lesson-rows {
		border-top: 1px solid var(--color-border);
	}

	.lesson-row {
		display: block;
		padding: var(--spacing-8) 0;
		border-bottom: 1px solid var(--color-border);
		text-decoration: none;
		position: relative;
		transition: padding-left var(--transition-base);
	}

	.lesson-row::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-base);
	}

	html[dir="rtl"] .lesson-row::before {
		transform-origin: right;
	}

	.lesson-row:hover::before {
		transform: scaleX(1);
	}

	.lesson-row:hover {
		padding-left: var(--spacing-4);
	}

	html[dir="rtl"] .lesson-row:hover {
		padding-left: 0;
		padding-right: var(--spacing-4);
	}

	.row-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: var(--spacing-3);
	}

	.row-num {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.row-year {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		color: var(--color-muted);
	}

	.row-lang {
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--color-border);
		border-radius: 2px;
		font-size: 10px;
		letter-spacing: 0.02em;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.row-title {
		font-family: var(--font-serif);
		font-size: var(--font-size-xl);
		font-weight: 500;
		color: var(--color-text);
		letter-spacing: -0.01em;
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.lesson-row:hover .row-title {
		color: var(--color-accent);
	}

	.row-desc {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: 1.6;
		max-width: 640px;
		margin-bottom: var(--spacing-4);
	}

	.row-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.row-arrow {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		transition: transform var(--transition-fast), color var(--transition-fast);
	}

	.lesson-row:hover .row-arrow {
		color: var(--color-accent);
		transform: translate(4px, -2px);
	}

	html[dir="rtl"] .lesson-row:hover .row-arrow {
		transform: translate(-4px, -2px);
	}
</style>
